# Astro app environment — copy to astro-app/.env and fill in.
# Astro auto-loads this file in dev/build; Vercel reads the same vars from project settings.

SUPABASE_URL=https://chemyzlmjqvnoxeqxfku.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Server-side only — NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin panel (/admin) ──────────────────────────────────────────────────────
# REQUIRED in production. If ADMIN_PASSWORD is not set in production, the env-var
# login fallback is DISABLED (the baked-in dev default is refused), so set these.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Signs the stateless admin session cookie. REQUIRED in production — if left as the
# dev default, anyone who knows it can forge admin sessions. Use a long random value.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Unified Publishing Center (/admin/dashboard?tab=publishing) ──────────────
# Public production origin used in OAuth callbacks and Website news links.
PUBLIC_SITE_URL=https://www.willowsoft.co
# Separate long random values for OAuth state signing and AES-256-GCM token storage.
SOCIAL_OAUTH_STATE_SECRET=change-me-to-another-long-random-string
SOCIAL_TOKEN_ENCRYPTION_KEY=change-me-to-a-32-byte-or-longer-random-string
# Used by Vercel Cron when invoking /api/cron/publications.
CRON_SECRET=change-me-to-a-long-random-string

# LinkedIn Developer App + Company Page (Community Management API access needed).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_DISPLAY_NAME=WillowSoft
LINKEDIN_USERNAME=willowsoft
LINKEDIN_API_VERSION=202607

# Instagram Professional account / Business Login for Instagram.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
META_GRAPH_VERSION=v23.0

# X Developer App with OAuth 2.0 write access and API credits.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional search-engine ownership verification tokens.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
