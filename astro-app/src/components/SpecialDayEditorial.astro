---
import type { Locale } from "@/lib/cms";
import type { SpecialDay, SpecialDayGreeting } from "@/data/special-days";

interface Props {
  specialDay: SpecialDay;
  greeting: SpecialDayGreeting;
  activeDate: Date;
  locale: Locale;
}

const { specialDay, greeting, activeDate, locale } = Astro.props;

const dayNumber = String(activeDate.getUTCDate()).padStart(2, "0");
const monthNumber = String(activeDate.getUTCMonth() + 1).padStart(2, "0");
const countryCode = specialDay.countries[0] === "*" ? "GLOBAL" : specialDay.countries[0];

const kickerByDay: Record<string, Record<string, string>> = {
  "tr-republic-day": { tr: "TÜRKİYE CUMHURİYETİ • 1923", en: "REPUBLIC OF TURKEY • 1923" },
  "tr-national-sovereignty-day": { tr: "TÜRKİYE CUMHURİYETİ • 23 NİSAN", en: "TURKEY • APRIL 23" },
  "tr-youth-sports-day": { tr: "TÜRKİYE CUMHURİYETİ • 19 MAYIS", en: "TURKEY • MAY 19" },
  "tr-victory-day": { tr: "TÜRKİYE CUMHURİYETİ • 30 AĞUSTOS", en: "TURKEY • AUGUST 30" },
  "us-independence-day": { en: "UNITED STATES OF AMERICA • 1776", tr: "AMERİKA BİRLEŞİK DEVLETLERİ • 1776" },
  "us-thanksgiving": { en: "UNITED STATES OF AMERICA • THANKSGIVING", tr: "AMERİKA BİRLEŞİK DEVLETLERİ • ŞÜKRAN GÜNÜ" },
  "gb-st-georges-day": { en: "UNITED KINGDOM • ST GEORGE", tr: "BİRLEŞİK KRALLIK • AZİZ GEORGE GÜNÜ" },
  "de-unity-day": { de: "BUNDESREPUBLIK DEUTSCHLAND • 1990", en: "FEDERAL REPUBLIC OF GERMANY • 1990", tr: "ALMANYA BİRLİK GÜNÜ • 1990" },
  "pt-portugal-day": { pt: "REPÚBLICA PORTUGUESA • 1572", en: "PORTUGUESE REPUBLIC • 1572", tr: "PORTEKİZ CUMHURİYETİ • 1572" },
  "pt-liberty-day": { pt: "REPÚBLICA PORTUGUESA • 1974", en: "PORTUGUESE REPUBLIC • 1974", tr: "PORTEKİZ CUMHURİYETİ • 1974" },
  "pt-republic-day": { pt: "REPÚBLICA PORTUGUESA • 1910", en: "PORTUGUESE REPUBLIC • 1910", tr: "PORTEKİZ CUMHURİYETİ • 1910" },
  "pt-restoration-day": { pt: "REPÚBLICA PORTUGUESA • 1640", en: "PORTUGUESE REPUBLIC • 1640", tr: "PORTEKİZ CUMHURİYETİ • 1640" },
  "sa-national-day": { ar: "المملكة العربية السعودية • ١٣٥١", en: "KINGDOM OF SAUDI ARABIA • 1932", tr: "SUUDİ ARABİSTAN KRALLIĞI • 1932" },
  "sa-founding-day": { ar: "المملكة العربية السعودية • يوم التأسيس", en: "KINGDOM OF SAUDI ARABIA • FOUNDING DAY", tr: "SUUDİ ARABİSTAN KRALLIĞI • KURULUŞ GÜNÜ" },
  "fr-bastille-day": { fr: "RÉPUBLIQUE FRANÇAISE • 1789", en: "FRENCH REPUBLIC • 1789", tr: "FRANSA CUMHURİYETİ • 1789" },
  "it-republic-day": { it: "REPUBBLICA ITALIANA • 1946", en: "ITALIAN REPUBLIC • 1946", tr: "İTALYA CUMHURİYETİ • 1946" },
  "es-fiesta-nacional": { es: "REINO DE ESPAÑA • 1492", en: "KINGDOM OF SPAIN • 1492", tr: "İSPANYA KRALLIĞI • 1492" },
  "jp-foundation-day": { ja: "日本国 • 建国記念の日", en: "STATE OF JAPAN • FOUNDATION DAY", tr: "JAPONYA DEVLETİ • KURULUŞ GÜNÜ" },
  "qa-national-day": { ar: "دولة قطر • ١٨٧٨", en: "STATE OF QATAR • 1878", tr: "KATAR DEVLETİ • 1878" },
  "ae-national-day": { ar: "الإمارات العربية المتحدة • ١٩٧١", en: "UNITED ARAB EMIRATES • 1971", tr: "BİRLEŞİK ARAP EMİRLİKLERİ • 1971" },
};

const kickerMap = kickerByDay[specialDay.id] || {};
const kickerText = kickerMap[locale] || kickerMap.en || `${countryCode} • ${monthNumber}/${dayNumber}`;

// Prominent brand celebration header text per locale
const brandCelebratesByLocale: Record<string, string> = {
  tr: "WILLOWSOFT KUTLUYOR",
  en: "WILLOWSOFT CELEBRATES",
  de: "WILLOWSOFT FEERT MIT",
  fr: "WILLOWSOFT CÉLÈBRE",
  es: "WILLOWSOFT CELEBRA",
  it: "WILLOWSOFT FESTEGGIA",
  ar: "WILLOWSOFT يحتفل",
  ja: "WILLOWSOFT お祝い",
};
const brandHeader = brandCelebratesByLocale[locale] || "WILLOWSOFT CELEBRATES";

const motifByEvent: Record<string, string> = {
  "tr-republic-day": "crescent",
  "us-independence-day": "stars",
  "de-unity-day": "unity",
  "pt-portugal-day": "orbit",
  "sa-national-day": "geometry",
  "fr-bastille-day": "bands",
  "it-republic-day": "bands",
  "qa-national-day": "serrated",
  "ae-national-day": "bands",
  "es-fiesta-nacional": "rays",
  "jp-foundation-day": "sun",
  "gb-st-georges-day": "cross",
};

const motif = specialDay.motif || motifByEvent[specialDay.id] || "orbit";
---

<div
  class:list={["republic-day-art", "editorial-day-art", `day-${specialDay.id}`, `motif-${motif}`]}
  style={`--day-accent:${specialDay.accentColor};--day-secondary:${specialDay.secondaryColor || specialDay.accentColor}`}
  lang={locale}
  dir={locale === "ar" ? "rtl" : "ltr"}
  aria-label={`${greeting.title} ${greeting.accent}`}
>
  <!-- Ultra-Optimized High-Performance WebP Backdrop -->
  <div class="editorial-image-backdrop">
    <img 
      src={`${import.meta.env.BASE_URL}assets/special-days/${specialDay.id}.webp`} 
      alt=""
      class="editorial-banner-img"
      onerror="this.style.opacity='0'; this.style.pointerEvents='none';"
      loading="eager"
      decoding="async"
    />
    <div class="editorial-banner-overlay"></div>
  </div>

  <!-- High-Tech Country SVG Flag Frame Backdrop (Native Fallback) -->
  <svg class="republic-day-lines" viewBox="0 0 1440 720" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id={`day-signal-${specialDay.id}`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="var(--day-accent)" stop-opacity="0" />
        <stop offset=".3" stop-color="var(--day-accent)" stop-opacity=".75" />
        <stop offset=".72" stop-color="var(--day-secondary)" stop-opacity=".6" />
        <stop offset="1" stop-color="var(--day-secondary)" stop-opacity="0" />
      </linearGradient>
      <filter id={`day-soft-glow-${specialDay.id}`} x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="8" result="blur" />
        <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>
  </svg>

  <!-- Volumetric Soft Ambient Glow Pulse -->
  <div class="editorial-ambient-glow" aria-hidden="true"></div>

  <!-- Multilingual Live Premium Typography Layer with WillowSoft Celebrates Header -->
  <div class="editorial-hero-content">
    <div class="editorial-kicker-line cinematic-item item-1">
      <span class="kicker-dot"></span>
      <span class="kicker-text">{brandHeader} • {kickerText}</span>
    </div>

    <h1 class="republic-day-title">
      <span class="title-main cinematic-item item-2">{greeting.title}</span>
      <span class="title-accent cinematic-item item-3">{greeting.accent}</span>
    </h1>

    <div class="republic-day-subline cinematic-item item-4">
      <span class="subline-line"></span>
      <span class="subline-brand">WILLOWSOFT</span>
    </div>
  </div>

  <!-- Floating Ambient Particles -->
  <div class="celebration-sparks" aria-hidden="true">
    <span class="spark s1"></span>
    <span class="spark s2"></span>
    <span class="spark s3"></span>
    <span class="spark s4"></span>
    <span class="spark s5"></span>
    <span class="spark s6"></span>
  </div>

  <!-- 5.8s Auto-Dismiss Progress Bar -->
  <div class="celebration-progress-bar" aria-hidden="true">
    <div class="celebration-progress-fill"></div>
  </div>
</div>
