---
import type { Locale } from "@/lib/cms";
import type { SpecialDay, SpecialDayGreeting } from "@/data/special-days";

interface Props {
  specialDay: SpecialDay;
  greeting: SpecialDayGreeting;
  activeDate: Date;
  locale: Locale;
}

const { specialDay, greeting, activeDate, locale } = Astro.props;

const dayNumber = String(activeDate.getUTCDate()).padStart(2, "0");
const monthNumber = String(activeDate.getUTCMonth() + 1).padStart(2, "0");
const countryCode = specialDay.countries[0] === "*" ? "GLOBAL" : specialDay.countries[0];
const fallbackDate = `${monthNumber}/${dayNumber}`;
let localizedCountry = countryCode;
let localizedDate = fallbackDate;
try {
  localizedCountry = countryCode === "GLOBAL"
    ? ({ en: "Global", tr: "Dünya", de: "Weltweit", fr: "Monde", es: "Mundo", it: "Mondo", ar: "العالم", ja: "世界" }[locale] || "Global")
    : new Intl.DisplayNames([locale], { type: "region" }).of(countryCode) || countryCode;
  localizedDate = new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", timeZone: "UTC" }).format(activeDate);
} catch {
  // Keep stable ISO-like fallbacks when the server runtime lacks full Intl data.
}
const kickerText = `${localizedCountry} • ${localizedDate}`;
const sublineText = greeting.subline.replace(/\s+[—–-]\s+Willow Software\s*$/i, "");

// Prominent brand celebration header text per locale
const brandCelebratesByLocale: Record<string, string> = {
  tr: "WILLOW SOFTWARE KUTLUYOR",
  en: "WILLOW SOFTWARE CELEBRATES",
  de: "WILLOW SOFTWARE GRATULIERT",
  fr: "WILLOW SOFTWARE CÉLÈBRE",
  es: "WILLOW SOFTWARE CELEBRA",
  it: "WILLOW SOFTWARE CELEBRA",
  ar: "WILLOW SOFTWARE تهنّئكم",
  ja: "WILLOW SOFTWAREより心を込めて",
};
const brandHeader = brandCelebratesByLocale[locale] || "WILLOW SOFTWARE CELEBRATES";

const motifByEvent: Record<string, string> = {
  "tr-republic-day": "crescent",
  "us-independence-day": "stars",
  "de-unity-day": "unity",
  "pt-portugal-day": "orbit",
  "sa-national-day": "geometry",
  "fr-bastille-day": "bands",
  "it-republic-day": "bands",
  "qa-national-day": "serrated",
  "ae-national-day": "bands",
  "es-fiesta-nacional": "rays",
  "jp-foundation-day": "sun",
  "gb-st-georges-day": "cross",
};

const motif = specialDay.motif || motifByEvent[specialDay.id] || "orbit";
---

<div
  class:list={["republic-day-art", "editorial-day-art", `day-${specialDay.id}`, `motif-${motif}`]}
  style={`--day-accent:${specialDay.accentColor};--day-secondary:${specialDay.secondaryColor || specialDay.accentColor}`}
  lang={locale}
  dir={locale === "ar" ? "rtl" : "ltr"}
  aria-label={`${greeting.title} ${greeting.accent}`}
>
  <!-- Ultra-Optimized High-Performance WebP Backdrop -->
  <div class="editorial-image-backdrop">
    <img 
      src={`${import.meta.env.BASE_URL}assets/special-days/${specialDay.id}.webp`} 
      alt=""
      class="editorial-banner-img"
      onerror="this.style.opacity='0'; this.style.pointerEvents='none';"
      loading="eager"
      decoding="async"
    />
    <div class="editorial-banner-overlay"></div>
  </div>

  <!-- High-Tech Country SVG Flag Frame Backdrop (Native Fallback) -->
  <svg class="republic-day-lines" viewBox="0 0 1440 720" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id={`day-signal-${specialDay.id}`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="var(--day-accent)" stop-opacity="0" />
        <stop offset=".3" stop-color="var(--day-accent)" stop-opacity=".75" />
        <stop offset=".72" stop-color="var(--day-secondary)" stop-opacity=".6" />
        <stop offset="1" stop-color="var(--day-secondary)" stop-opacity="0" />
      </linearGradient>
      <filter id={`day-soft-glow-${specialDay.id}`} x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="8" result="blur" />
        <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>
  </svg>

  <!-- Volumetric Soft Ambient Glow Pulse -->
  <div class="editorial-ambient-glow" aria-hidden="true"></div>

  <!-- Multilingual Live Premium Typography Layer with Willow Software Celebrates Header -->
  <div class="editorial-hero-content">
    <div class="editorial-kicker-line cinematic-item item-1">
      <span class="kicker-dot"></span>
      <span class="kicker-text">{brandHeader} • {kickerText}</span>
    </div>

    <h1 class="republic-day-title">
      <span class="title-main cinematic-item item-2">{greeting.title}</span>
      <span class="title-accent cinematic-item item-3">{greeting.accent}</span>
    </h1>

    <div class="republic-day-subline cinematic-item item-4">
      <span class="subline-line"></span>
      <span class="subline-copy">{sublineText}</span>
      <span class="subline-brand">WILLOW SOFTWARE</span>
    </div>
  </div>

  <!-- Floating Ambient Particles -->
  <div class="celebration-sparks" aria-hidden="true">
    <span class="spark s1"></span>
    <span class="spark s2"></span>
    <span class="spark s3"></span>
    <span class="spark s4"></span>
    <span class="spark s5"></span>
    <span class="spark s6"></span>
  </div>

  <!-- 5.8s Auto-Dismiss Progress Bar -->
  <div class="celebration-progress-bar" aria-hidden="true">
    <div class="celebration-progress-fill"></div>
  </div>
</div>
