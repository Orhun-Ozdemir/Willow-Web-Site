---
import { localizeItem, resolveAsset, resolveLocale, type Locale } from "@/lib/cms";
import { DEFAULT_PRODUCT_CATEGORIES, productCategoryLabel, type ProductCategory } from "@/lib/product-categories";
import { productCutoutDimensions, productCutoutSrcSet } from "@/lib/image-metadata";
import { productSearchDescriptor } from "@/lib/seo-fallbacks";
import { localizeCatalogValue } from "@/lib/lorawan-landing";

interface Props {
  product: any;
  locale: Locale;
  index: number;
  variant?: "default" | "catalog";
  categories?: ProductCategory[];
}

const { product, index, variant = "default", categories = DEFAULT_PRODUCT_CATEGORIES } = Astro.props;
const locale = resolveLocale(Astro.props.locale, Astro.url.pathname);
const p = localizeItem(product, locale);
const productBrand = typeof product.title === "string" ? product.title : p.title;
const delay = index % 4 ? ` delay-${index % 4}` : "";
const chips = (p.chips || []).slice(0, 3).map((chip: string) => localizeCatalogValue(chip, locale));

const cutoutImage =
  resolveAsset(p.cardImage) ||
  resolveAsset(p.image) ||
  resolveAsset(`assets/product-cutouts/${p.id}.png`);
const cutoutDimensions = productCutoutDimensions(cutoutImage);
const cutoutSrcSet = productCutoutSrcSet(cutoutImage);
const detailsLabel: Record<Locale, string> = {
  en: "View product",
  tr: "Ürünü İncele",
  de: "Produkt ansehen",
  fr: "Voir le produit",
  es: "Ver producto",
  it: "Vedi prodotto",
  ar: "عرض المنتج",
  ja: "製品を見る",
};
const detailsAriaLabel: Record<Locale, (name: string) => string> = {
  en: (name) => `View ${name}`,
  tr: (name) => `${name} ürününü inceleyin`,
  de: (name) => `${name} ansehen`,
  fr: (name) => `Voir ${name}`,
  es: (name) => `Ver ${name}`,
  it: (name) => `Vedi ${name}`,
  ar: (name) => `عرض ${name}`,
  ja: (name) => `${name}を見る`,
};
// Category is a stable technical key and must never be replaced by a localized value.
const displayCategory = String(product.category || "environment");
const categoryLabel = productCategoryLabel(categories, displayCategory, locale);
const searchDescriptor = productSearchDescriptor(product.id || p.id, locale);
const imageAlt = searchDescriptor ? `${productBrand} — ${searchDescriptor}` : productBrand;
const detailsText = detailsLabel[locale] || detailsLabel.en;
const detailsAccessibleName = (detailsAriaLabel[locale] || detailsAriaLabel.en)(productBrand);
---

<article class={`card product-card${variant === "catalog" ? " product-card-premium" : ""} reveal${delay}`} data-category={displayCategory} data-product={p.id}>
  <figure>
    {variant === "catalog" && <a class="product-card-category" href={`/${locale}/products/category/${displayCategory}`}>{categoryLabel}</a>}
    <img
      src={cutoutImage}
      srcset={cutoutSrcSet}
      sizes="(max-width: 480px) 130px, (max-width: 760px) 160px, 180px"
      width={cutoutDimensions?.width}
      height={cutoutDimensions?.height}
      alt={imageAlt}
      loading="lazy"
      decoding="async"
      onerror="this.onerror=null; this.src='/assets/willow-mark-64.webp'; this.removeAttribute('srcset'); this.style.opacity='0.15';"
    />
    {variant === "catalog" && <span class="product-card-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>}
  </figure>
  <div class="product-body">
    <h3>{productBrand}</h3>
    <p class="product-description">{p.shortDescription}</p>
    <div class="chip-row">
      {chips.map((chip: string) => (
        <span class="chip">{chip}</span>
      ))}
    </div>
    <div class="product-actions">
      <a href={`/${locale}/products/${encodeURIComponent(p.slug || p.id)}`} class="btn btn-ghost btn-small product-card-link" aria-label={detailsAccessibleName}>
        <span>{detailsText}</span>
        {variant === "catalog" && <span class="product-action-arrow" aria-hidden="true">↗</span>}
      </a>
    </div>
  </div>
</article>
