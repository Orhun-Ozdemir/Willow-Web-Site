---
export interface Props {
  flag: string;
  title: string;
  message: string;
  revealDelay?: string;
  /** When true, renders as a button that replays the homepage hero celebration on click. */
  replayable?: boolean;
}

const { flag, title, message, revealDelay = ".35s", replayable = false } = Astro.props;
const base = import.meta.env.BASE_URL?.replace(/\/$/, "") || "";
const Tag = replayable ? "button" : "div";
---

<Tag
  class:list={["national-day-note", { "is-replayable": replayable }]}
  role={replayable ? undefined : "status"}
  type={replayable ? "button" : undefined}
  aria-label={replayable ? `${title} — animasyonu tekrar oynat` : title}
  data-reveal-delay={revealDelay}
  data-replay-badge={replayable ? "true" : undefined}
>
  <span class="national-day-note-flag" aria-hidden="true">
    <img
      src={`${base}/assets/flags/${flag}.svg`}
      alt=""
      width="20"
      height="20"
      loading="lazy"
      decoding="async"
    />
  </span>
  <span class="national-day-note-message">{message}</span>
  {replayable && <span class="national-day-note-replay" aria-hidden="true">↻</span>}
</Tag>

<script>
  // A pure CSS `animation-delay` only advances while the page is actually being
  // rendered — on a backgrounded/inactive tab the animation timeline can stall
  // indefinitely, leaving this note stuck at opacity:0 forever. Reveal it from
  // JS instead (setTimeout keeps firing regardless of tab visibility), and only
  // start the delay once the page is genuinely visible.
  // Non-home pages wrap the full greeting (no truncation) so it can run to several
  // lines, and it sits absolutely-positioned over page content below the header —
  // fine to read, not fine to leave parked over the page title forever. The
  // replayable badge (home page) is a standing control, so it stays put; the
  // plain announcement on other pages fades itself out after a read window.
  const AUTO_HIDE_MS = 7000;

  document.querySelectorAll<HTMLElement>("[data-reveal-delay]").forEach((note) => {
    const delayMs = Math.max(0, parseFloat(note.dataset.revealDelay || "0.35") * 1000);
    const reveal = () => {
      window.setTimeout(() => {
        note.classList.add("is-visible");
        if (!note.dataset.replayBadge) {
          window.setTimeout(() => note.classList.remove("is-visible"), AUTO_HIDE_MS);
        }
      }, delayMs);
    };
    if (document.hidden) {
      const onVisible = () => {
        if (document.hidden) return;
        document.removeEventListener("visibilitychange", onVisible);
        reveal();
      };
      document.addEventListener("visibilitychange", onVisible);
    } else {
      reveal();
    }
  });

  document.querySelectorAll<HTMLButtonElement>("[data-replay-badge]").forEach((btn) => {
    btn.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("willow:replay-celebration"));
    });
  });
</script>

<style>
  .national-day-note {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 9px;
    max-width: min(560px, calc(100vw - 32px));
    min-height: 32px;
    border-radius: 18px;
    padding: 5px 13px 5px 6px;
    border: 1px solid rgba(227, 10, 23, .14);
    color: rgba(19, 27, 46, .78);
    background: rgba(255, 255, 255, .9);
    box-shadow: 0 10px 28px rgba(19, 27, 46, .1);
    transform: translate(-50%, -12px);
    opacity: 0;
    transition: opacity .7s cubic-bezier(.16, 1, .3, 1), transform .7s cubic-bezier(.16, 1, .3, 1);
    backdrop-filter: blur(18px) saturate(1.15);
    pointer-events: none;
  }

  .national-day-note.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  button.national-day-note {
    appearance: none;
    font: inherit;
    text-align: left;
  }

  .national-day-note.is-replayable {
    pointer-events: auto;
    cursor: pointer;
    transition: background-color .18s ease, box-shadow .18s ease;
  }

  /* transform is left untouched on :hover/:active — .is-visible (above) already set it. */
  .national-day-note.is-replayable:hover,
  .national-day-note.is-replayable:focus-visible {
    background: #fff;
    box-shadow: 0 14px 32px rgba(19, 27, 46, .16);
  }

  .national-day-note.is-replayable:focus-visible {
    outline: 2px solid #23a8d8;
    outline-offset: 2px;
  }

  .national-day-note-replay {
    flex: 0 0 auto;
    font-size: .78rem;
    color: rgba(19, 27, 46, .4);
    transition: color .18s ease, transform .3s ease;
  }

  .national-day-note.is-replayable:hover .national-day-note-replay,
  .national-day-note.is-replayable:focus-visible .national-day-note-replay {
    color: #132175;
    transform: rotate(90deg);
  }

  .national-day-note-flag {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    padding: 2px;
    overflow: hidden;
    border: 1px solid rgba(19, 33, 117, .1);
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 3px 9px rgba(19, 27, 46, .12);
  }

  .national-day-note-flag img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .national-day-note-message {
    font-size: .68rem;
    font-weight: 720;
    line-height: 1.35;
    letter-spacing: .015em;
    white-space: normal;
  }

  @media (max-width: 900px) {
    .national-day-note {
      top: calc(100% + 6px);
      max-width: calc(100vw - 32px);
      min-height: 29px;
      padding: 4px 11px 4px 5px;
    }

    .national-day-note-flag { width: 20px; height: 20px; }
    .national-day-note-message { font-size: .62rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .national-day-note { opacity: 1; transform: translate(-50%, 0); transition: none; }
  }
</style>
