---
import ProductCard from "./ProductCard.astro";
import { localizeItem, type Locale } from "@/lib/cms";
import { productCategoryText, type ProductCategory } from "@/lib/product-categories";
import { productSearchDescriptor } from "@/lib/seo-fallbacks";
import { categorySearchName, COLLECTION_TABLE_LABELS, LORAWAN_LANDING_COPY, localizeCatalogValue } from "@/lib/lorawan-landing";
import { GUIDE_INDEX_COPY, TECHNICAL_GUIDES } from "@/lib/technical-guides";
import { accessibilityCopy } from "@/lib/accessibility-copy";

interface Props {
  locale: Locale;
  products: any[];
  allProducts?: any[];
  categories: ProductCategory[];
  selectedCategory?: ProductCategory;
}

const { locale, products, allProducts = products, categories, selectedCategory } = Astro.props;
const copy = LORAWAN_LANDING_COPY[locale] || LORAWAN_LANDING_COPY.en;
const visibleCategories = categories.filter((category) => category.visible);
const heroTitle = selectedCategory ? categorySearchName(selectedCategory.key, locale) : copy.title;
const categoryText = selectedCategory ? productCategoryText(selectedCategory, locale) : null;
const categoryDescription = String(categoryText?.description || "").trim();
const heroLead = selectedCategory
  ? `${categoryDescription}${categoryDescription && !/[.!?؟。]$/.test(categoryDescription) ? "." : ""} ${copy.portfolioLead}`.trim()
  : copy.intro;
const guideCopy = GUIDE_INDEX_COPY[locale];
const directProductIds = ["willowpre", "willowsonic", "willowair", "willowmod", "willowgps"];
const directProducts = selectedCategory ? [] : directProductIds
  .map((id) => allProducts.find((product) => String(product.id).toLowerCase() === id))
  .filter(Boolean)
  .map((product) => ({ raw: product, localized: localizeItem(product, locale) }));
const tableLabels = COLLECTION_TABLE_LABELS[locale] || COLLECTION_TABLE_LABELS.en;
const comparisonProducts = selectedCategory ? [] : allProducts
  .filter((product) => product.visible !== false)
  .map((raw) => {
    const localized = localizeItem(raw, locale);
    const specifications = raw.specifications && typeof raw.specifications === "object" && !Array.isArray(raw.specifications)
      ? raw.specifications
      : {};
    const firstValue = (...keys: string[]) => keys
      .map((key) => specifications[key] ?? raw[key] ?? localized[key])
      .find((value) => value !== undefined && value !== null && String(value).trim());
    const category = visibleCategories.find((item) => item.key === String(raw.category || ""));
    return {
      raw,
      localized,
      brand: typeof raw.title === "string" ? raw.title : localized.title,
      type: raw.localized?.[locale]?.type || productSearchDescriptor(raw.id, locale) || localized.type || "—",
      enclosure: localizeCatalogValue(firstValue("enclosure"), locale),
      measurementRange: localizeCatalogValue(firstValue("measurement_range", "measurementRange", "pressure_range", "pressureRange", "sensing_radius", "sensingRadius"), locale),
      radio: localizeCatalogValue(firstValue("protocol", "wireless_protocol", "wirelessProtocol"), locale),
      battery: localizeCatalogValue(firstValue("battery_life", "batteryLife"), locale),
      category: category ? productCategoryText(category, locale).title : String(raw.category || "—"),
    };
  });
---

<main id="main-content" class="lorawan-landing">
  <section class="lorawan-hero">
    <div class="section-inner lorawan-hero-grid">
      <div>
        <nav class="lorawan-breadcrumb" aria-label={accessibilityCopy("breadcrumb", locale)}>
          <a href={`/${locale}/products`}>{copy.allProducts}</a>
          {selectedCategory && <><span>/</span><a href={`/${locale}/lorawan-sensors`}>{copy.categoryBack}</a></>}
        </nav>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{heroTitle}</h1>
        <p class="lorawan-hero-lead">{heroLead}</p>
      </div>
      <aside class="lorawan-evidence-note">
        <span aria-hidden="true">i</span>
        <p>{copy.evidenceNote}</p>
      </aside>
    </div>
  </section>

  {directProducts.length > 0 && (
    <section class="lorawan-direct" aria-labelledby="lorawan-direct-title">
      <div class="section-inner lorawan-direct-layout">
        <div class="lorawan-direct-copy">
          <p class="eyebrow">{copy.portfolioTitle}</p>
          <h2 id="lorawan-direct-title">{copy.featuredTitle}</h2>
          <p>{copy.featuredLead}</p>
        </div>
        <div class="lorawan-direct-grid">
          {directProducts.map(({ raw, localized }) => (
            <a href={`/${locale}/products/${localized.slug || raw.id}`}>
              <span>{productSearchDescriptor(raw.id, locale)}</span>
              <strong>{typeof raw.title === "string" ? raw.title : localized.title}</strong>
              <p>{localized.shortDescription}</p>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section lorawan-families">
    <div class="section-inner">
      <div class="section-head">
        <div>
          <p class="eyebrow">{copy.familiesTitle}</p>
          <h2>{selectedCategory ? copy.categoryBack : copy.familiesTitle}</h2>
          <p class="section-lead">{copy.familiesLead}</p>
        </div>
      </div>
      <div class="lorawan-family-grid">
        {visibleCategories.map((category, index) => {
          const text = productCategoryText(category, locale);
          const count = allProducts.filter((product) => String(product.category) === category.key).length;
          return (
            <a class:list={["lorawan-family-card", { active: selectedCategory?.key === category.key }]} href={`/${locale}/products/category/${category.key}`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{categorySearchName(category.key, locale)}</h3>
              <p>{text.description}</p>
              <strong>{count}</strong>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {!selectedCategory && (
    <section class="section soft lorawan-selection" aria-labelledby="lorawan-selection-title">
      <div class="section-inner">
        <div class="section-head lorawan-selection-head">
          <div>
            <p class="eyebrow">{copy.selectionEyebrow}</p>
            <h2 id="lorawan-selection-title">{copy.selectionTitle}</h2>
            <p class="section-lead">{copy.selectionIntro}</p>
          </div>
          <aside class="lorawan-selection-note">
            <strong>IP</strong>
            <p>{copy.selectionNote}</p>
          </aside>
        </div>
        <div class="lorawan-selection-grid">
          {copy.selectionCriteria.map((criterion, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{criterion.title}</h3>
              <p>{criterion.text}</p>
            </article>
          ))}
        </div>
        <div class="lorawan-integration-note">
          <h3>{copy.integrationTitle}</h3>
          <p>{copy.integrationText}</p>
        </div>
      </div>
    </section>
  )}

  {selectedCategory ? (
    <section class="section soft lorawan-products">
      <div class="section-inner">
        <div class="section-head">
          <div>
            <p class="eyebrow">{copy.portfolioTitle}</p>
            <h2>{heroTitle}</h2>
            <p class="section-lead">{copy.portfolioLead}</p>
          </div>
        </div>
        <div class="grid grid-4 product-atlas-grid">
          {products.map((product, index) => (
            <ProductCard product={product} locale={locale} index={index} variant="catalog" categories={categories} />
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="section lorawan-comparison" aria-labelledby="lorawan-comparison-title">
      <div class="section-inner">
        <div class="section-head lorawan-comparison-head">
          <div>
            <p class="eyebrow">{copy.comparisonEyebrow}</p>
            <h2 id="lorawan-comparison-title">{copy.comparisonTitle}</h2>
            <p class="section-lead">{copy.comparisonLead}</p>
          </div>
          <a href={`/${locale}/products`}>{copy.allProducts} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="lorawan-table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">{tableLabels.product}</th>
                <th scope="col">{tableLabels.measures}</th>
                <th scope="col">{tableLabels.enclosure}</th>
                <th scope="col">{tableLabels.measurementRange}</th>
                <th scope="col">{tableLabels.radio}</th>
                <th scope="col">{tableLabels.battery}</th>
              </tr>
            </thead>
            <tbody>
              {comparisonProducts.map((item) => (
                <tr>
                  <th scope="row">
                    <a href={`/${locale}/products/${item.raw.slug || item.raw.id}`}>
                      <strong>{item.brand}</strong>
                      <span>{item.category}</span>
                    </a>
                  </th>
                  <td>{item.type}</td>
                  <td>{item.enclosure || "—"}</td>
                  <td>{item.measurementRange || "—"}</td>
                  <td>{item.radio || "—"}</td>
                  <td>{item.battery || "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="lorawan-comparison-note">{copy.comparisonNote}</p>
      </div>
    </section>
  )}

  <section class="section soft lorawan-guides">
    <div class="section-inner">
      <div class="section-head">
        <div><p class="eyebrow">{guideCopy.eyebrow}</p><h2>{guideCopy.title}</h2><p class="section-lead">{guideCopy.intro}</p></div>
        <a class="lorawan-guide-all" href={`/${locale}/guides`}>{guideCopy.allGuides} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="lorawan-guide-grid">
        {TECHNICAL_GUIDES.map((guide) => (
          <a class="lorawan-guide-card" href={`/${locale}/guides/${guide.slug}`}>
            <span>{guide.readingMinutes} {guideCopy.minutes}</span>
            <h3>{guide.localized[locale].title}</h3>
            <p>{guide.localized[locale].description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</main>

<style>
  .lorawan-landing { background: #fff; }
  .lorawan-hero { padding: 150px 0 72px; overflow: hidden; background: radial-gradient(circle at 82% 22%, rgba(35,168,216,.13), transparent 29%), linear-gradient(145deg, #07152f, #111c49 62%, #17184e); color: #fff; }
  .lorawan-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .42fr); gap: clamp(34px, 6vw, 88px); align-items: end; }
  .lorawan-breadcrumb { display: flex; gap: 9px; margin-bottom: 28px; color: rgba(255,255,255,.7); font-size: .78rem; font-weight: 750; }
  .lorawan-breadcrumb a:hover { color: #fff; }
  .lorawan-hero .eyebrow { color: #72dfc3; }
  .lorawan-hero h1 { max-width: 900px; margin: 14px 0 24px; font-size: clamp(2.8rem, 6vw, 6.2rem); line-height: .96; letter-spacing: -.055em; }
  .lorawan-hero-lead { max-width: 760px; color: rgba(255,255,255,.78); font-size: clamp(1rem, 1.4vw, 1.2rem); line-height: 1.7; }
  .lorawan-evidence-note { display: grid; grid-template-columns: 30px 1fr; gap: 14px; padding: 20px; border: 1px solid rgba(255,255,255,.14); border-radius: 18px; background: rgba(255,255,255,.07); backdrop-filter: blur(16px); }
  .lorawan-evidence-note span { display: grid; width: 28px; height: 28px; place-items: center; border-radius: 50%; background: #72dfc3; color: #07152f; font-weight: 900; }
  .lorawan-evidence-note p { margin: 0; color: rgba(255,255,255,.76); font-size: .83rem; line-height: 1.55; }
  .lorawan-direct { padding: 34px 0; border-bottom: 1px solid rgba(19,33,117,.1); background: #f6f8fc; }
  .lorawan-direct-layout { display: grid; grid-template-columns: minmax(210px, .34fr) minmax(0, 1fr); gap: 30px; align-items: center; }
  .lorawan-direct-copy h2 { margin: 7px 0 8px; color: var(--ink); font-size: clamp(1.35rem, 2vw, 1.8rem); letter-spacing: -.03em; }
  .lorawan-direct-copy > p:last-child { margin: 0; color: rgba(19,27,46,.62); font-size: .8rem; line-height: 1.55; }
  .lorawan-direct-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(155px, 1fr)); gap: 9px; }
  .lorawan-direct-grid a { position: relative; min-width: 0; min-height: 142px; padding: 15px 34px 15px 15px; border: 1px solid rgba(19,33,117,.1); border-radius: 14px; background: #fff; transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .lorawan-direct-grid a:hover { transform: translateY(-2px); border-color: rgba(35,168,216,.45); box-shadow: 0 12px 30px rgba(16,31,92,.08); }
  .lorawan-direct-grid span { display: block; min-height: 2.5em; color: rgba(19,33,117,.55); font-size: .61rem; font-weight: 800; line-height: 1.25; text-transform: uppercase; }
  .lorawan-direct-grid strong { display: block; margin-top: 6px; overflow-wrap: anywhere; color: var(--ink); font-size: .91rem; line-height: 1.2; }
  .lorawan-direct-grid p { display: -webkit-box; margin: 8px 0 0; overflow: hidden; color: rgba(19,27,46,.62); font-size: .7rem; line-height: 1.4; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .lorawan-direct-grid i { position: absolute; top: 14px; right: 14px; color: var(--blue); font-style: normal; font-size: .75rem; }
  .lorawan-families { padding: 76px 0 64px; }
  .lorawan-family-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .lorawan-family-card { position: relative; min-height: 210px; padding: 22px; overflow: hidden; border: 1px solid rgba(19,33,117,.12); border-radius: 20px; background: linear-gradient(145deg, #fff, #f5f8ff); transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .lorawan-family-card:hover, .lorawan-family-card.active { transform: translateY(-4px); border-color: rgba(35,168,216,.5); box-shadow: 0 20px 52px rgba(16,31,92,.1); }
  .lorawan-family-card > span { color: rgba(19,33,117,.45); font: 800 .7rem var(--font-body); letter-spacing: .1em; }
  .lorawan-family-card h3 { max-width: 14ch; margin: 28px 0 12px; color: var(--ink); font-size: 1.25rem; line-height: 1.15; }
  .lorawan-family-card p { margin: 0; color: rgba(19,27,46,.64); font-size: .84rem; line-height: 1.5; }
  .lorawan-family-card strong { position: absolute; right: 18px; bottom: 14px; color: rgba(19,33,117,.16); font-size: 2.5rem; }
  .lorawan-products { padding: 70px 0 78px; }
  .lorawan-selection { padding: 74px 0; }
  .lorawan-selection-head { align-items: end; }
  .lorawan-selection-note { display: grid; grid-template-columns: 38px minmax(0, 1fr); gap: 14px; max-width: 490px; padding: 18px; border: 1px solid rgba(19,33,117,.12); border-radius: 16px; background: #fff; }
  .lorawan-selection-note strong { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 10px; background: rgba(35,168,216,.12); color: var(--blue); font-size: .78rem; }
  .lorawan-selection-note p { margin: 0; color: rgba(19,27,46,.66); font-size: .78rem; line-height: 1.55; }
  .lorawan-selection-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .lorawan-selection-grid article { min-height: 175px; padding: 21px; border: 1px solid rgba(19,33,117,.1); border-radius: 17px; background: #fff; }
  .lorawan-selection-grid article > span { color: rgba(19,33,117,.42); font-size: .66rem; font-weight: 850; letter-spacing: .09em; }
  .lorawan-selection-grid h3 { margin: 22px 0 9px; color: var(--ink); font-size: 1rem; }
  .lorawan-selection-grid p { margin: 0; color: rgba(19,27,46,.64); font-size: .79rem; line-height: 1.55; }
  .lorawan-integration-note { display: grid; grid-template-columns: minmax(180px, .35fr) minmax(0, 1fr); gap: 28px; align-items: center; margin-top: 14px; padding: 22px 24px; border-radius: 17px; background: linear-gradient(135deg, #0b1c40, #17245b); color: #fff; }
  .lorawan-integration-note h3 { margin: 0; font-size: 1rem; }
  .lorawan-integration-note p { margin: 0; color: rgba(255,255,255,.76); font-size: .82rem; line-height: 1.6; }
  .lorawan-comparison { padding: 74px 0 82px; }
  .lorawan-comparison-head { align-items: end; }
  .lorawan-comparison-head > a { flex: 0 0 auto; padding: 12px 16px; border-radius: 11px; background: var(--blue); color: #fff; font-size: .75rem; font-weight: 850; }
  .lorawan-table-wrap { overflow-x: auto; border: 1px solid rgba(19,33,117,.12); border-radius: 18px; background: #fff; box-shadow: 0 18px 50px rgba(16,31,92,.06); }
  .lorawan-table-wrap table { width: 100%; min-width: 980px; border-collapse: collapse; color: var(--ink); text-align: left; }
  .lorawan-table-wrap th, .lorawan-table-wrap td { padding: 16px 15px; border-bottom: 1px solid rgba(19,33,117,.09); vertical-align: top; }
  .lorawan-table-wrap thead th { background: #f3f6fb; color: rgba(19,33,117,.65); font-size: .67rem; font-weight: 850; letter-spacing: .055em; text-transform: uppercase; }
  .lorawan-table-wrap tbody th { min-width: 150px; }
  .lorawan-table-wrap tbody td { color: rgba(19,27,46,.72); font-size: .78rem; line-height: 1.45; }
  .lorawan-table-wrap tbody tr:last-child th, .lorawan-table-wrap tbody tr:last-child td { border-bottom: 0; }
  .lorawan-table-wrap tbody tr:hover { background: rgba(35,168,216,.035); }
  .lorawan-table-wrap tbody a strong, .lorawan-table-wrap tbody a span { display: block; }
  .lorawan-table-wrap tbody a strong { color: var(--blue); font-size: .86rem; }
  .lorawan-table-wrap tbody a span { margin-top: 4px; color: rgba(19,27,46,.53); font-size: .68rem; font-weight: 600; }
  .lorawan-comparison-note { margin: 14px 2px 0; color: rgba(19,27,46,.58); font-size: .72rem; line-height: 1.55; }
  .lorawan-catalog-link { padding: 0 0 70px; }
  .lorawan-catalog-layout { display: flex; gap: 28px; align-items: center; justify-content: space-between; padding: 26px 30px; border: 1px solid rgba(19,33,117,.11); border-radius: 18px; background: linear-gradient(135deg, #f7f9fd, #eef3fb); }
  .lorawan-catalog-layout h2 { margin: 7px 0 8px; color: var(--ink); font-size: clamp(1.35rem, 2.2vw, 1.9rem); letter-spacing: -.03em; }
  .lorawan-catalog-layout p:last-child { margin: 0; color: rgba(19,27,46,.65); font-size: .84rem; line-height: 1.55; }
  .lorawan-catalog-layout > a { flex: 0 0 auto; padding: 13px 17px; border-radius: 12px; background: var(--blue); color: #fff; font-size: .76rem; font-weight: 850; }
  .lorawan-guides { padding: 70px 0 88px; }
  .lorawan-guide-all { color: var(--blue); font-size: .78rem; font-weight: 850; }
  .lorawan-guide-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .lorawan-guide-card { min-height: 230px; padding: 22px; border: 1px solid rgba(19,33,117,.12); border-radius: 18px; background: #fff; transition: transform .2s ease, border-color .2s ease; }
  .lorawan-guide-card:hover { transform: translateY(-4px); border-color: rgba(35,168,216,.48); }
  .lorawan-guide-card > span { color: rgba(19,33,117,.5); font-size: .64rem; font-weight: 850; letter-spacing: .07em; text-transform: uppercase; }
  .lorawan-guide-card h3 { margin: 38px 0 12px; color: var(--ink); font-size: 1.17rem; line-height: 1.15; }
  .lorawan-guide-card p { margin: 0; color: rgba(19,27,46,.64); font-size: .82rem; line-height: 1.55; }
  @media (max-width: 980px) { .lorawan-direct-layout { grid-template-columns: 1fr; gap: 18px; } .lorawan-family-grid { grid-template-columns: repeat(2, 1fr); } .lorawan-selection-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .lorawan-hero { padding: 112px 0 52px; }
    .lorawan-hero-grid { grid-template-columns: 1fr; gap: 26px; }
    .lorawan-direct { padding: 28px 0; }
    .lorawan-direct-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lorawan-hero h1 { font-size: clamp(2.55rem, 12vw, 4rem); }
    .lorawan-families, .lorawan-products, .lorawan-selection, .lorawan-comparison, .lorawan-guides { padding: 48px 0; }
    .lorawan-selection-head, .lorawan-comparison-head { align-items: flex-start; }
    .lorawan-selection-note { max-width: none; }
    .lorawan-selection-grid { grid-template-columns: 1fr; }
    .lorawan-selection-grid article { min-height: 0; }
    .lorawan-integration-note { grid-template-columns: 1fr; gap: 9px; }
    .lorawan-catalog-link { padding: 0 0 48px; }
    .lorawan-catalog-layout { align-items: flex-start; flex-direction: column; padding: 22px; }
    .lorawan-guide-grid { grid-template-columns: 1fr; }
    .lorawan-guide-card { min-height: 190px; }
    .lorawan-family-card { min-height: 170px; padding: 18px; }
    .lorawan-family-card h3 { margin-top: 20px; font-size: 1rem; }
  }
  @media (max-width: 480px) { .lorawan-direct-grid { grid-template-columns: 1fr 1fr; } .lorawan-direct-grid a { min-height: 136px; padding: 13px 28px 13px 13px; } .lorawan-family-grid { grid-template-columns: 1fr 1fr; gap: 10px; } .lorawan-family-card { min-height: 184px; } }
</style>
