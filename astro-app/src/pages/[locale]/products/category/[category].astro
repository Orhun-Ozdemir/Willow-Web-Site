---
import PageLayout from "@/layouts/PageLayout.astro";
import LorawanCollection from "@/components/LorawanCollection.astro";
import { loadContent } from "@/lib/content";
import { resolveLocale, localizedValue } from "@/lib/cms";
import { productCategoriesFromContent } from "@/lib/product-categories";
import { categorySearchName, categorySeoDescription } from "@/lib/lorawan-landing";
import { appendSchemaNodes } from "@/lib/ai-search";
import { buildAlternates, DEFAULT_OG_IMAGE, ORGANIZATION_SCHEMA, WEBSITE_SCHEMA, SITE_ORIGIN, fitSeoDescription, fitSeoTitle, webPageNode } from "@/lib/seo";

export const prerender = false;

const locale = resolveLocale(Astro.params.locale, Astro.url.pathname);
const categoryKey = String(Astro.params.category || "").trim().toLowerCase();
const content = await loadContent();
const categories = productCategoriesFromContent(content).filter((category) => category.visible);
const selectedCategory = categories.find((category) => category.key === categoryKey);

if (!selectedCategory) return Astro.rewrite(`/${locale}/not-found`);

const allProducts = (content.products || []).filter((product: any) => product.visible !== false);
const products = allProducts.filter((product: any) => String(product.category || "") === selectedCategory.key);
const searchName = categorySearchName(selectedCategory.key, locale);
const canonical = `${SITE_ORIGIN}/${locale}/products/category/${selectedCategory.key}`;
const title = fitSeoTitle(`${searchName} | WillowSoft`);
const description = fitSeoDescription(categorySeoDescription(selectedCategory.key, locale, products.length));
const itemListId = `${canonical}#products`;
const schema = appendSchemaNodes({
  "@context": "https://schema.org",
  "@graph": [
    ORGANIZATION_SCHEMA,
    WEBSITE_SCHEMA,
    {
      ...webPageNode("CollectionPage", canonical, title, description, locale),
      mainEntity: { "@id": itemListId },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "WillowSoft", item: `${SITE_ORIGIN}/${locale}` },
        { "@type": "ListItem", position: 2, name: "LoRaWAN", item: `${SITE_ORIGIN}/${locale}/lorawan-sensors` },
        { "@type": "ListItem", position: 3, name: searchName, item: canonical },
      ],
    },
    {
      "@type": "ItemList",
      "@id": itemListId,
      name: searchName,
      numberOfItems: products.length,
      itemListElement: products.map((product: any, index: number) => ({
        "@type": "ListItem",
        position: index + 1,
        name: localizedValue(product.title, locale),
        url: `${SITE_ORIGIN}/${locale}/products/${product.slug || product.id}`,
      })),
    },
  ],
}, []);
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogImage={DEFAULT_OG_IMAGE}
  alternates={buildAlternates(`/products/category/${selectedCategory.key}`)}
  schema={schema}
  locale={locale}
  dataPage="products"
>
  <LorawanCollection locale={locale} products={products} allProducts={allProducts} categories={categories} selectedCategory={selectedCategory} />
</PageLayout>
