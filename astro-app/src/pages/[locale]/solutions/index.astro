---
import PageLayout from "@/layouts/PageLayout.astro";
import SolutionCard from "@/components/SolutionCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import AIAnswerBlock from "@/components/AIAnswerBlock.astro";
import { loadContent } from "@/lib/content";
import { pageSeo, webPageNode, ORGANIZATION_SCHEMA, WEBSITE_SCHEMA } from "@/lib/seo";
import { localizedValue, localizeItem, pageButtonText, pageLocaleHref, pageText, resolveAsset, resolveLocale, type Locale } from "@/lib/cms";
import { aiAnswerForPage, aiMetaForPage, appendSchemaNodes, fallbackFaqsForPage, faqItemsForPage, faqSchemaNode } from "@/lib/ai-search";

export const prerender = false;

const locale = resolveLocale(Astro.params.locale, Astro.url.pathname);
const content = await loadContent();
const seoProps = pageSeo(content, "solutions", locale, "/solutions", "Solutions | WillowSoft", "Industry-specific IoT solutions.");
const pageContent = content.pageContent?.solutions || {};
const solutionsFallbackFaqs = fallbackFaqsForPage("solutions", locale);
const solutionsFaqItems = faqItemsForPage(content.faqs || [], "solutions", locale, solutionsFallbackFaqs);
const aiAnswer = aiAnswerForPage(content, "solutions", locale, seoProps.description);
const aiMeta = aiMetaForPage(content, "solutions", locale);

const solutions = (content.solutions || []).sort((a: any, b: any) => (a.sortOrder || 0) - (b.sortOrder || 0));
const allProducts = content.products || [];
const solutionCategories: string[] = [
  "All",
  ...Array.from(new Set<string>(solutions.map((s: any) => String(s.category || "")).filter(Boolean))),
];

const categoryLabelMap = new Map<string, string>();
for (const sol of solutions) {
  const loc = localizeItem(sol, locale);
  if (sol.category && loc.category) categoryLabelMap.set(sol.category, loc.category);
}
const solutionsSchema = appendSchemaNodes({
  "@context": "https://schema.org",
  "@graph": [
    ORGANIZATION_SCHEMA,
    WEBSITE_SCHEMA,
    webPageNode("CollectionPage", seoProps.canonical, seoProps.title, seoProps.description, locale),
  ],
}, [faqSchemaNode(seoProps.canonical, solutionsFaqItems)]);

const selectorCards = pageContent.selectorCards || [];
const howItWorksSteps = pageContent.howItWorksSteps || [];
const whyCards = pageContent.whyCards || [];

type SolutionFallbackCard = { eyebrow?: string; title: string; body: string; bullets?: string[] };

const selectorFallbacks: Record<Locale, SolutionFallbackCard[]> = {
  en: [
    { eyebrow: "Need visibility?", title: "Remote Monitoring", body: "For assets that are hard to reach, distributed across sites or still checked manually by field teams.", bullets: ["Live telemetry", "Asset status", "Historical trends"] },
    { eyebrow: "Need response?", title: "Alerts & Workflows", body: "For operations where level, pressure, motion, panic, door, GPS or air-quality events require immediate action.", bullets: ["Threshold alerts", "Mobile notifications", "Escalation flows"] },
    { eyebrow: "Need integration?", title: "Industrial Data Platform", body: "For telemetry that must feed reporting tools, ERP systems, customer portals, PostgreSQL or internal APIs.", bullets: ["Backend APIs", "Admin panels", "Data pipelines"] },
  ],
  tr: [
    { eyebrow: "Görünürlük mü gerekiyor?", title: "Uzaktan İzleme", body: "Erişilmesi zor, farklı sahalara dağılmış veya ekipler tarafından hâlâ manuel kontrol edilen varlıklar için.", bullets: ["Canlı telemetri", "Varlık durumu", "Geçmiş eğilimler"] },
    { eyebrow: "Hızlı müdahale mi gerekiyor?", title: "Uyarılar ve İş Akışları", body: "Seviye, basınç, hareket, panik, kapı, GPS veya hava kalitesi olaylarının anında müdahale gerektirdiği operasyonlar için.", bullets: ["Eşik uyarıları", "Mobil bildirimler", "Eskalasyon akışları"] },
    { eyebrow: "Entegrasyon mu gerekiyor?", title: "Endüstriyel Veri Platformu", body: "Raporlama araçlarını, ERP sistemlerini, müşteri portallarını, PostgreSQL veritabanını veya dahili API'leri beslemesi gereken telemetri için.", bullets: ["Backend API'leri", "Yönetim panelleri", "Veri hatları"] },
  ],
  de: [
    { eyebrow: "Mehr Transparenz benötigt?", title: "Fernüberwachung", body: "Für schwer zugängliche, auf mehrere Standorte verteilte oder noch manuell kontrollierte Anlagen.", bullets: ["Live-Telemetrie", "Anlagenstatus", "Historische Trends"] },
    { eyebrow: "Schnelle Reaktion erforderlich?", title: "Alarme & Workflows", body: "Für Betriebsabläufe, bei denen Füllstand, Druck, Bewegung, Panik, Türstatus, GPS oder Luftqualität sofortiges Handeln erfordern.", bullets: ["Schwellenwertalarme", "Mobile Benachrichtigungen", "Eskalationsabläufe"] },
