    { eyebrow: "¿Necesita una respuesta rápida?", title: "Alertas y flujos de trabajo", body: "Para operaciones donde los eventos de nivel, presión, movimiento, pánico, puerta, GPS o calidad del aire exigen actuar de inmediato.", bullets: ["Alertas por umbral", "Notificaciones móviles", "Flujos de escalado"] },
    { eyebrow: "¿Necesita integración?", title: "Plataforma de datos industriales", body: "Para telemetría que debe alimentar herramientas de informes, sistemas ERP, portales de clientes, PostgreSQL o API internas.", bullets: ["API de backend", "Paneles de administración", "Pipelines de datos"] },
  ],
  it: [
    { eyebrow: "Serve maggiore visibilità?", title: "Monitoraggio remoto", body: "Per asset difficili da raggiungere, distribuiti su più siti o ancora controllati manualmente dagli operatori sul campo.", bullets: ["Telemetria in tempo reale", "Stato degli asset", "Trend storici"] },
    { eyebrow: "Serve una risposta rapida?", title: "Avvisi e workflow", body: "Per operazioni in cui eventi di livello, pressione, movimento, panico, porta, GPS o qualità dell'aria richiedono un intervento immediato.", bullets: ["Avvisi a soglia", "Notifiche mobili", "Flussi di escalation"] },
    { eyebrow: "Serve un'integrazione?", title: "Piattaforma dati industriale", body: "Per telemetria destinata ad alimentare strumenti di reporting, sistemi ERP, portali clienti, PostgreSQL o API interne.", bullets: ["API backend", "Pannelli di amministrazione", "Pipeline di dati"] },
  ],
  ar: [
    { eyebrow: "هل تحتاج إلى رؤية أوضح؟", title: "المراقبة عن بُعد", body: "للأصول التي يصعب الوصول إليها، أو الموزعة بين مواقع متعددة، أو التي ما زالت الفرق الميدانية تفحصها يدوياً.", bullets: ["قياس آني عن بُعد", "حالة الأصول", "الاتجاهات التاريخية"] },
    { eyebrow: "هل تحتاج إلى استجابة سريعة؟", title: "التنبيهات ومسارات العمل", body: "للعمليات التي تتطلب فيها أحداث المستوى أو الضغط أو الحركة أو الاستغاثة أو الأبواب أو GPS أو جودة الهواء تدخلاً فورياً.", bullets: ["تنبيهات الحدود", "إشعارات الجوال", "مسارات التصعيد"] },
    { eyebrow: "هل تحتاج إلى تكامل؟", title: "منصة البيانات الصناعية", body: "للبيانات الميدانية التي يجب أن تغذي أدوات التقارير وأنظمة ERP وبوابات العملاء وقواعد PostgreSQL أو واجهات API الداخلية.", bullets: ["واجهات API للخلفية", "لوحات الإدارة", "مسارات البيانات"] },
  ],
  ja: [
